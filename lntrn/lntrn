#!/usr/bin/env bash
# ── lntrn ─────────────────────────────────────────────────────────────────────
# Displays system information alongside an ANSI Lantern - For Lantern DE
# Dependencies: python3, python-pillow
# Install: ln -sf "$(pwd)/lntrn" ~/.local/bin/lntrn

set -euo pipefail

# ── Flag parsing ──────────────────────────────────────────────────────────────
LIVE_MODE=0
NO_ANIM=0
for arg in "$@"; do
    case "$arg" in
        --live)    LIVE_MODE=1 ;;
        --no-anim) NO_ANIM=1 ;;
    esac
done
export LNTRN_LIVE="$LIVE_MODE"
export LNTRN_NO_ANIM="$NO_ANIM"

# ── System monitor mode ──────────────────────────────────────────────────────
if [[ "${1:-}" == "--sysmon" ]]; then
    # Handoff to the fancy Python TUI dashboard (installed or dev-tree)
    if [[ -f /usr/share/lntrn/lntrn-sysmon-view ]]; then
        SYSMON_VIEW="/usr/share/lntrn/lntrn-sysmon-view"
    else
        SCRIPT_PATH="$(readlink -f "$0")"
        SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
        SYSMON_VIEW="$SCRIPT_DIR/lntrn-sysmon-view"
    fi
    if [[ ! -f "$SYSMON_VIEW" ]]; then
        echo "Error: lntrn-sysmon-view not found (looked in /usr/share/lntrn and $SCRIPT_DIR)" >&2
        exit 1
    fi
    exec python3 "$SYSMON_VIEW"
fi

# ── File manager mode ────────────────────────────────────────────────────────
if [[ "${1:-}" == "--files" ]]; then
    # Handoff to the 2-pane Python TUI file manager (installed or dev-tree)
    if [[ -f /usr/share/lntrn/lntrn-files-view ]]; then
        FILES_VIEW="/usr/share/lntrn/lntrn-files-view"
    else
        SCRIPT_PATH="$(readlink -f "$0")"
        SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
        FILES_VIEW="$SCRIPT_DIR/lntrn-files-view"
    fi
    if [[ ! -f "$FILES_VIEW" ]]; then
        echo "Error: lntrn-files-view not found (looked in /usr/share/lntrn and $SCRIPT_DIR)" >&2
        exit 1
    fi
    shift
    exec python3 "$FILES_VIEW" "$@"
fi

# ── ASCII art gallery ─────────────────────────────────────────────────────────
if [[ "${1:-}" == "--art" ]]; then
    # Pre-baked colored ASCII art (installed or dev-tree). Pure cat — no deps.
    if [[ -d /usr/share/lntrn/art ]]; then
        ART_DIR="/usr/share/lntrn/art"
    else
        SCRIPT_PATH="$(readlink -f "$0")"
        SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
        ART_DIR="$SCRIPT_DIR/art"
    fi
    shift
    # A name plus an optional --clean/-c flag, in any order.
    NAME=""
    CLEAN=0
    for a in "$@"; do
        case "$a" in
            --clean|-c) CLEAN=1 ;;
            -*)         echo "Error: unknown art option '$a'" >&2; exit 1 ;;
            *)          [[ -z "$NAME" ]] && NAME="$a" ;;
        esac
    done
    if [[ -z "$NAME" ]]; then
        echo "Available art:"
        shopt -s nullglob
        found=0
        for f in "$ART_DIR"/*.ans; do
            echo "  $(basename "$f" .ans)"
            found=1
        done
        shopt -u nullglob
        [[ "$found" == 0 ]] && echo "  (none yet — generate with lntrn-art-gen)"
        echo
        echo "Usage: lntrn --art <name> [--clean]"
        echo "  --clean   fullscreen, no prompt — press any key to exit (for screenshots)"
        exit 0
    fi
    ART_FILE="$ART_DIR/$NAME.ans"
    if [[ ! -f "$ART_FILE" ]]; then
        echo "Error: no art named '$NAME' (try: lntrn --art)" >&2
        exit 1
    fi
    if [[ "$CLEAN" == 1 ]]; then
        # Alternate screen + hidden cursor → just the art, no prompt. Restored
        # on any exit (keypress, Ctrl+C). Perfect for ricing screenshots.
        trap 'printf "\033[?25h\033[?1049l"' EXIT
        printf '\033[?1049h\033[H\033[2J\033[?25l'
        cat "$ART_FILE"
        read -rsn1 </dev/tty || true
    else
        cat "$ART_FILE"
    fi
    exit 0
fi

# ── Resolve icon path ─────────────────────────────────────────────────────────
# Check installed location first, then dev tree
if [[ -f /usr/share/lntrn/lntrn.png ]]; then
    ICON="/usr/share/lntrn/lntrn.png"
else
    SCRIPT_PATH="$(readlink -f "$0")"
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    ICON="$SCRIPT_DIR/assets/lntrn.png"
fi

if [[ ! -f "$ICON" ]]; then
    echo "Error: Icon not found at $ICON"
    exit 1
fi

# ── System info gathering ─────────────────────────────────────────────────────
USER_NAME="${USER:-$(whoami)}"
HOST_NAME="${HOSTNAME:-$(hostname)}"
DISTRO=$(grep -m1 "^PRETTY_NAME=" /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')
KERNEL=$(uname -sr)
SHELL_NAME=$(basename "${SHELL:-unknown}")
UPTIME=$(uptime -p 2>/dev/null | sed 's/up //' || echo "unknown")
TERMINAL="${TERM_PROGRAM:-${TERMINAL:-unknown}}"
[[ "$TERMINAL" == "unknown" ]] && TERMINAL=$(ps -o comm= -p "$(ps -o ppid= -p $$)" 2>/dev/null || echo "unknown")

CPU=$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ //' | sed 's/(R)//g; s/(TM)//g; s/CPU //g')
CPU=${CPU:-"unknown"}

# Cores (unique physical core ids) and threads (logical processors)
CPU_CORES=$(grep "^core id" /proc/cpuinfo 2>/dev/null | sort -u | wc -l)
CPU_THREADS=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo 0)

# Max frequency — highest cpuinfo_max_freq across all cores (handles hybrid CPUs)
CPU_MAX_GHZ=""
if [[ -e /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq ]]; then
    max_khz=$(cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq 2>/dev/null | sort -rn | head -1)
    if [[ -n "$max_khz" && "$max_khz" -gt 0 ]]; then
        CPU_MAX_GHZ=$(awk "BEGIN {printf \"%.1f\", $max_khz/1000000}")
    fi
fi

[[ -n "$CPU_MAX_GHZ" ]] && CPU="${CPU} @ ${CPU_MAX_GHZ}GHz"
if [[ "$CPU_CORES" -gt 0 && "$CPU_THREADS" -gt 0 ]]; then
    CPU="${CPU} (${CPU_CORES}C/${CPU_THREADS}T)"
fi

if [[ -f /proc/meminfo ]]; then
    MEM_TOTAL=$(awk '/MemTotal/ {printf "%.0f", $2/1024}' /proc/meminfo)
    MEM_AVAIL=$(awk '/MemAvailable/ {printf "%.0f", $2/1024}' /proc/meminfo)
    MEM_USED=$((MEM_TOTAL - MEM_AVAIL))
    MEMORY="${MEM_USED}MiB / ${MEM_TOTAL}MiB"
else
    MEMORY="unknown"
fi

if command -v emerge &>/dev/null || [[ -d /var/db/pkg ]]; then
    PKG_COUNT=$(find /var/db/pkg -mindepth 2 -maxdepth 2 -type d 2>/dev/null | wc -l)
    PACKAGES="${PKG_COUNT} (portage)"
elif command -v pacman &>/dev/null; then
    PKG_COUNT=$(pacman -Q 2>/dev/null | wc -l)
    PACKAGES="${PKG_COUNT} (pacman)"
elif command -v dpkg &>/dev/null; then
    PKG_COUNT=$(dpkg -l 2>/dev/null | grep -c '^ii')
    PACKAGES="${PKG_COUNT} (dpkg)"
elif command -v rpm &>/dev/null; then
    PKG_COUNT=$(rpm -qa 2>/dev/null | wc -l)
    PACKAGES="${PKG_COUNT} (rpm)"
else
    PACKAGES="unknown"
fi

if [[ -n "${XDG_CURRENT_DESKTOP:-}" ]]; then
    DE_WM="$XDG_CURRENT_DESKTOP"
elif [[ -n "${DESKTOP_SESSION:-}" ]]; then
    DE_WM="$DESKTOP_SESSION"
else
    DE_WM="unknown"
fi

# Only append version for non-Lantern DEs
if [[ "$DE_WM" != "Lantern" ]]; then
    DE_VERSION=""
    if command -v plasmashell &>/dev/null; then
        DE_VERSION=$(plasmashell --version 2>/dev/null | awk '{print $2}')
    elif command -v gnome-shell &>/dev/null; then
        DE_VERSION=$(gnome-shell --version 2>/dev/null | awk '{print $3}')
    elif command -v xfce4-session &>/dev/null; then
        DE_VERSION=$(xfce4-session --version 2>/dev/null | head -1 | awk '{print $2}')
    elif command -v cinnamon &>/dev/null; then
        DE_VERSION=$(cinnamon --version 2>/dev/null | awk '{print $2}')
    fi
    [[ -n "$DE_VERSION" ]] && DE_WM="$DE_WM $DE_VERSION"
fi

GPU=$(lspci 2>/dev/null | grep -i 'vga\|3d\|display' | head -1 | sed 's/.*: //' | sed 's/ Corporation//;s/ \[.*//;s/ (.*//;s/Intel /Intel /' | cut -c1-40)
GPU=${GPU:-"unknown"}

# ── Display server ────────────────────────────────────────────────────────────
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    DISPLAY_SERVER="Wayland"
elif [[ -n "${DISPLAY:-}" ]]; then
    DISPLAY_SERVER="X11"
else
    DISPLAY_SERVER="tty"
fi

# ── Monitor detection ─────────────────────────────────────────────────────────
MONITORS=""
for drm_dir in /sys/class/drm/card*-*/; do
    [[ -f "$drm_dir/status" ]] || continue
    [[ "$(cat "$drm_dir/status" 2>/dev/null)" == "connected" ]] || continue

    output=$(basename "$drm_dir")
    # Strip card prefix → DP-1, HDMI-A-1, eDP-1 etc
    output=${output#card*-}

    res=$(head -1 "$drm_dir/modes" 2>/dev/null)
    res=${res:-"?"}

    # Parse EDID for monitor model name + refresh rate (from preferred DTD)
    mon_name=""
    refresh=""
    if [[ -f "$drm_dir/edid" ]]; then
        edid_out=$(python3 -c "
import sys
try:
    with open(sys.argv[1], 'rb') as f:
        edid = f.read()
    name = ''
    if len(edid) >= 128:
        for i in range(4):
            off = 54 + i * 18
            if edid[off+3] == 0xFC:
                name = edid[off+5:off+18].decode('ascii', errors='ignore').strip()
                break
        if not name:
            m = (edid[8] << 8) | edid[9]
            name = chr(((m>>10)&0x1F)+64) + chr(((m>>5)&0x1F)+64) + chr((m&0x1F)+64)
        # Preferred DTD at offset 54 — extract refresh rate
        d = edid[54:72]
        pclk = (d[0] | (d[1] << 8)) * 10000  # Hz
        if pclk:
            h_act = d[2] | ((d[4] & 0xF0) << 4)
            h_blk = d[3] | ((d[4] & 0x0F) << 8)
            v_act = d[5] | ((d[7] & 0xF0) << 4)
            v_blk = d[6] | ((d[7] & 0x0F) << 8)
            h_tot, v_tot = h_act + h_blk, v_act + v_blk
            if h_tot and v_tot:
                hz = pclk / (h_tot * v_tot)
                print(name)
                print(f'{hz:.0f}')
                sys.exit()
    print(name)
except: pass
" "$drm_dir/edid" 2>/dev/null)
        mon_name=$(echo "$edid_out" | sed -n '1p')
        refresh=$(echo "$edid_out" | sed -n '2p')
    fi

    [[ -n "$refresh" ]] && res="${res}@${refresh}Hz"

    if [[ -n "$mon_name" ]]; then
        entry="$mon_name ($output) $res"
    else
        entry="$output $res"
    fi

    if [[ -z "$MONITORS" ]]; then
        MONITORS="$entry"
    else
        MONITORS="$MONITORS|$entry"
    fi
done
MONITORS=${MONITORS:-"unknown"}

# ── Battery (laptop only) ────────────────────────────────────────────────────
BATTERY=""
for bat in /sys/class/power_supply/BAT*; do
    [[ -f "$bat/capacity" ]] || continue
    pct=$(cat "$bat/capacity" 2>/dev/null)
    status=$(cat "$bat/status" 2>/dev/null)
    BATTERY="${pct}% (${status})"
    break
done

# ── Render icon + system info ─────────────────────────────────────────────────
export LNTRN_USER="$USER_NAME"
export LNTRN_HOST="$HOST_NAME"
export LNTRN_DISTRO="$DISTRO"
export LNTRN_KERNEL="$KERNEL"
export LNTRN_SHELL="$SHELL_NAME"
export LNTRN_TERMINAL="$TERMINAL"
export LNTRN_UPTIME="$UPTIME"
export LNTRN_PACKAGES="$PACKAGES"
export LNTRN_DE="$DE_WM"
export LNTRN_CPU="$CPU"
export LNTRN_GPU="$GPU"
export LNTRN_MEMORY="$MEMORY"
export LNTRN_DISPLAY="$DISPLAY_SERVER"
export LNTRN_MONITORS="$MONITORS"
export LNTRN_BATTERY="$BATTERY"

TERM_COLS="$(tput cols 2>/dev/null || echo 80)"
python3 - "$ICON" "$TERM_COLS" << 'PYEOF'
import sys, os
from PIL import Image

# Adapt to terminal width
try:
    term_cols = int(sys.argv[2])
except (IndexError, ValueError):
    try:
        term_cols = os.get_terminal_size().columns
    except OSError:
        term_cols = 80

# Scale icon width based on available space.
# Side-by-side needs ~32 cols for info, so icon gets the rest.
# Minimum icon width 12, max 24.
INFO_MIN = 32
if term_cols >= INFO_MIN + 28:
    W = min(24, term_cols - INFO_MIN - 6)
elif term_cols >= INFO_MIN + 16:
    W = min(18, term_cols - INFO_MIN - 4)
else:
    W = max(12, min(18, term_cols - 4))

img = Image.open(sys.argv[1]).convert('RGBA')
H = int(W * img.height / img.width / 2 + 0.5) * 2
img = img.resize((W, H), Image.LANCZOS)

# Fix LANCZOS resampling artifacts at high-contrast boundaries
import math
pixels = img.load()
fixes = []
for y in range(H):
    for x in range(W):
        r, g, b, a = pixels[x, y]
        if a < 80:
            continue
        neighbors = []
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                if dx == 0 and dy == 0:
                    continue
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H:
                    nr, ng, nb, na = pixels[nx, ny]
                    if na > 80:
                        neighbors.append((nr, ng, nb))
        if len(neighbors) < 3:
            continue
        avg = tuple(sum(c[i] for c in neighbors) // len(neighbors) for i in range(3))
        dist = math.sqrt(sum((a - b) ** 2 for a, b in zip((r, g, b), avg)))
        if dist > 70:
            fixes.append((x, y, (*avg, 255)))
for x, y, color in fixes:
    pixels[x, y] = color

raw = img.tobytes()

def px(x, y):
    i = (y * W + x) * 4
    return (raw[i], raw[i+1], raw[i+2], raw[i+3])

# Flame mask: warm-bright pixels that should flicker
flame_mask = [[False] * W for _ in range(H)]
for y in range(H):
    for x in range(W):
        r, g, b, a = px(x, y)
        if a > 80 and r > 150 and g > 60 and r > b + 40:
            flame_mask[y][x] = True

def _shade(c, factor):
    return (min(255, int(c[0] * factor)),
            min(255, int(c[1] * factor)),
            min(255, int(c[2] * factor)),
            c[3])

def render_art(flicker=1.0):
    lines = []
    for y in range(0, H, 2):
        parts = []
        for x in range(W):
            top = px(x, y)
            bot = px(x, y + 1) if y + 1 < H else (0, 0, 0, 0)
            if flicker != 1.0:
                if flame_mask[y][x]:
                    top = _shade(top, flicker)
                if y + 1 < H and flame_mask[y + 1][x]:
                    bot = _shade(bot, flicker)
            ta, ba = top[3], bot[3]
            if ta > 80 and ba > 80:
                parts.append(f"\033[48;2;{top[0]};{top[1]};{top[2]}m\033[38;2;{bot[0]};{bot[1]};{bot[2]}m▄")
            elif ta > 80:
                parts.append(f"\033[0m\033[38;2;{top[0]};{top[1]};{top[2]}m▀")
            elif ba > 80:
                parts.append(f"\033[0m\033[38;2;{bot[0]};{bot[1]};{bot[2]}m▄")
            else:
                parts.append("\033[0m ")
        lines.append("".join(parts) + "\033[0m")
    return lines

art_lines = render_art(1.0)

O = "\033[38;2;212;160;32m"
B = "\033[1m"
R = "\033[0m"
D = "\033[38;2;120;90;55m"
user = os.environ.get('LNTRN_USER', '?')
host = os.environ.get('LNTRN_HOST', '?')

# Layout metrics — computed early so info[] can use them
COL = W + 6
info_avail = term_cols - COL  # columns available for info text

def lerp(a, b, t):
    return int(round(a + (b - a) * t))

def sample_gradient(colors, t):
    if t <= 0:
        return colors[0]
    if t >= 1:
        return colors[-1]
    pos = t * (len(colors) - 1)
    idx = int(pos)
    frac = pos - idx
    c1 = colors[idx]
    c2 = colors[min(idx + 1, len(colors) - 1)]
    return tuple(lerp(c1[i], c2[i], frac) for i in range(3))

def strip_ansi(text):
    out = []
    i = 0
    while i < len(text):
        if text[i] == "\033":
            i += 1
            if i < len(text) and text[i] == "[":
                i += 1
                while i < len(text) and text[i] != "m":
                    i += 1
                if i < len(text):
                    i += 1
            continue
        out.append(text[i])
        i += 1
    return "".join(out)

def dot_row(colors, max_dots=None):
    if max_dots is not None:
        colors = colors[:max_dots]
    return "  " + " ".join(f"\033[38;2;{r};{g};{b}m⬤" for r, g, b in colors) + R

sep_len = max(12, min(26, info_avail - 4)) if info_avail >= 20 else max(12, min(26, term_cols - 6))
separator = "─" * sep_len
info = [
    f"  {B}{O}{user}{R}{D}@{R}{B}{O}{host}{R}",
    f"  {D}{separator}{R}",
    f"  {O}OS{R}        {os.environ.get('LNTRN_DISTRO', '?')}",
    f"  {O}Kernel{R}    {os.environ.get('LNTRN_KERNEL', '?')}",
    f"  {O}Shell{R}     {os.environ.get('LNTRN_SHELL', '?')}",
    f"  {O}Terminal{R}  {os.environ.get('LNTRN_TERMINAL', '?')}",
    f"  {O}Uptime{R}    {os.environ.get('LNTRN_UPTIME', '?')}",
    f"  {O}Packages{R}  {os.environ.get('LNTRN_PACKAGES', '?')}",
    f"  {O}DE/WM{R}     {os.environ.get('LNTRN_DE', '?')}",
    f"  {O}Display{R}   {os.environ.get('LNTRN_DISPLAY', '?')}",
]

# Add monitors right after Display
monitors = os.environ.get('LNTRN_MONITORS', '')
if monitors:
    mons = monitors.split('|')
    info.append(f"  {O}Monitor{R}   {mons[0]}")
    for m in mons[1:]:
        info.append(f"            {m}")

info.extend([
    f"  {O}CPU{R}       {os.environ.get('LNTRN_CPU', '?')}",
    f"  {O}GPU{R}       {os.environ.get('LNTRN_GPU', '?')}",
    f"  {O}Memory{R}    {os.environ.get('LNTRN_MEMORY', '?')}",
])

# Battery — only shown on laptops
battery = os.environ.get('LNTRN_BATTERY', '')
if battery:
    info.append(f"  {O}Battery{R}   {battery}")

dot_avail = info_avail if info_avail >= 20 else term_cols - 4
max_dots = max(4, (dot_avail - 2) // 2)  # each dot + space is ~2 cols

amber_dots = [
    (180, 130, 70),
    (150, 110, 65),
    (120, 90, 55),
    (95, 75, 50),
    (75, 60, 40),
    (95, 75, 50),
    (120, 90, 55),
    (150, 110, 65),
]
gradient_stops = [
    (255, 105, 180),
    (59, 130, 246),
    (34, 197, 94),
    (250, 204, 21),
    (239, 68, 68),
]
n_grad = min(8, max_dots)
grad_dots = [sample_gradient(gradient_stops, i / max(1, n_grad - 1)) for i in range(n_grad)]

info.append("")
info.append(dot_row(amber_dots, max_dots))
info.append(dot_row(grad_dots, max_dots))
DOT_AMBER_IDX = len(info) - 2
DOT_GRAD_IDX  = len(info) - 1

def animated_dot_rows(t):
    beat = 0.5 + 0.5 * math.sin(t * 1.4)
    amber_now = [
        tuple(min(255, int(c * (0.65 + 0.55 * beat))) for c in color)
        for color in amber_dots
    ]
    shift = (t * 0.12) % 1.0
    grad_now = [
        sample_gradient(gradient_stops, ((i / max(1, n_grad - 1)) + shift) % 1.0)
        for i in range(n_grad)
    ]
    return dot_row(amber_now, max_dots), dot_row(grad_now, max_dots)

print()

def truncate_info(line, max_visible):
    """Truncate an info line to fit max_visible printable chars."""
    if max_visible <= 0:
        return ""
    visible = 0
    result = []
    i = 0
    text = line
    while i < len(text):
        if text[i] == "\033":
            # Copy full escape sequence without counting
            j = i + 1
            if j < len(text) and text[j] == "[":
                j += 1
                while j < len(text) and text[j] != "m":
                    j += 1
                if j < len(text):
                    j += 1
            result.append(text[i:j])
            i = j
        else:
            if visible >= max_visible:
                break
            result.append(text[i])
            visible += 1
            i += 1
    result.append(R)
    return "".join(result)

import random, time, signal

live_mode    = os.environ.get('LNTRN_LIVE') == '1'
no_anim      = os.environ.get('LNTRN_NO_ANIM') == '1'
animate      = (info_avail >= 20) and not no_anim
STARTUP_SECS = 4.0
FRAME_DELAY  = 0.09

def flicker_value(t):
    # Smooth slow drift (sine layers) + small noise — candle-like
    base  = 1.0
    base += 0.12 * math.sin(t * 2.2)
    base += 0.07 * math.sin(t * 4.7 + 1.3)
    base += 0.04 * math.sin(t * 8.1 + 2.6)
    return base + (random.random() - 0.5) * 0.06

def print_line(line, col_count):
    sys.stdout.write(line + "\033[K\n")

def render_block(art, info_now):
    out = []
    if info_avail >= 20:
        total = max(len(art), len(info_now))
        for i in range(total):
            a = art[i] if i < len(art) else ""
            inf_line = truncate_info(info_now[i], info_avail) if i < len(info_now) else ""
            out.append(f"  {a}\033[{COL}G{inf_line}\033[K")
    else:
        for line in art:
            out.append(f"  {line}\033[K")
        for line in info_now:
            out.append(truncate_info(line, term_cols - 2) + "\033[K")
    return out

total_lines = (max(len(art_lines), len(info)) if info_avail >= 20
               else len(art_lines) + len(info))

def frame_state(t, flicker):
    art_now = render_art(flicker) if flicker != 1.0 else art_lines
    info_now = info[:]
    if animate and DOT_AMBER_IDX < len(info_now):
        a_row, g_row = animated_dot_rows(t)
        info_now[DOT_AMBER_IDX] = a_row
        info_now[DOT_GRAD_IDX]  = g_row
    return art_now, info_now

def _cleanup(*_):
    sys.stdout.write("\033[?25h")
    sys.stdout.flush()
    print()
    sys.exit(0)

if not animate:
    art_now, info_now = frame_state(0.0, 1.0)
    for line in render_block(art_now, info_now):
        sys.stdout.write(line + "\n")
    print()
else:
    signal.signal(signal.SIGINT, _cleanup)
    sys.stdout.write("\033[?25l")
    art_now, info_now = frame_state(0.0, 1.0)
    for line in render_block(art_now, info_now):
        sys.stdout.write(line + "\n")
    sys.stdout.flush()
    start = time.time()
    try:
        while True:
            time.sleep(FRAME_DELAY)
            t = time.time() - start
            if not live_mode and t > STARTUP_SECS:
                break
            sys.stdout.write(f"\033[{total_lines}A\033[1G")
            if live_mode:
                intensity = 1.0
            else:
                tail = 0.9
                if t < STARTUP_SECS - tail:
                    intensity = 1.0
                else:
                    intensity = max(0.0, (STARTUP_SECS - t) / tail)
            flicker = 1.0 + (flicker_value(t) - 1.0) * intensity
            art_now, info_now = frame_state(t, flicker)
            for line in render_block(art_now, info_now):
                sys.stdout.write(line + "\n")
            sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    sys.stdout.write(f"\033[{total_lines}A\033[1G")
    art_now, info_now = frame_state(0.0, 1.0)
    for line in render_block(art_now, info_now):
        sys.stdout.write(line + "\n")
    sys.stdout.write("\033[?25h")
    sys.stdout.flush()
    print()
PYEOF

