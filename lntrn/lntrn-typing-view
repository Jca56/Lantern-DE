# ── Visible width & truncation (ANSI-aware) ────────────────────────────────
ANSI_RE = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
def char_w(ch):
    return 2 if unicodedata.east_asian_width(ch) in ('W', 'F') else 1
def vlen(s):
    return sum(char_w(c) for c in ANSI_RE.sub('', s))
def vtrunc(s, n):
    if n <= 0: return ''
    out, vis, i, L = [], 0, 0, len(s)
    while i < L:
        if s[i] == '\x1b':
            j = i + 1
            if j < L and s[j] == '[':
                j += 1
                while j < L and not s[j].isalpha(): j += 1
                if j < L: j += 1
            out.append(s[i:j]); i = j
        else:
            w = char_w(s[i])
            if vis + w > n: break
            out.append(s[i]); vis += w; i += 1
    out.append(RESET)
    return ''.join(out)
def pad_center(s, w):
    v = vlen(s)
    if v > w: return vtrunc(s, w)
    l = (w - v) // 2
    return ' '*l + s + ' '*(w - v - l)
def cline(s, cols):
    return ' ' * max(0, (cols - vlen(s)) // 2) + s

def lerp(a, b, t):
    return (int(a[0]+(b[0]-a[0])*t), int(a[1]+(b[1]-a[1])*t), int(a[2]+(b[2]-a[2])*t))

def fmt_t(secs):
    secs = max(0, int(secs))
    return f'{secs//60}:{secs%60:02d}'

