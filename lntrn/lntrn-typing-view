def gen_words(diff, n):
    out = []
    for _ in range(n):
        if diff == 'hard' and random.random() < 0.35:
            out.append(random.choice(HARD_TOKENS))
        else:
            w = random.choice(WORDS)
            if diff == 'hard':
                if random.random() < 0.15: w = w.capitalize()
                if random.random() < 0.15: w += random.choice('.,;:!?')
            out.append(w)
    return out

# ── History & personal bests ───────────────────────────────────────────────
def load_hist():
    try:
        with open(HIST_PATH) as f: d = json.load(f)
        if isinstance(d, dict) and isinstance(d.get('runs', []), list):
            d.setdefault('runs', []); d.setdefault('settings', {}); d.setdefault('pbs', {})
            if isinstance(d['pbs'], dict): return d
    except (OSError, ValueError): pass
    return {'runs': [], 'settings': {}, 'pbs': {}}

def save_hist(d):
    try:
        HIST_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = HIST_PATH.with_suffix('.tmp')
        with open(tmp, 'w') as f: json.dump(d, f)
        os.replace(tmp, HIST_PATH)
    except OSError: pass

def pb_key(diff, mode, dur): return f'{diff}|{mode}|{dur}'

def pb_for(hist, diff, mode, dur):
    """PB cache wins over the (pruned) run log; scanning runs migrates old files."""
    cached = hist['pbs'].get(pb_key(diff, mode, dur))
    best = cached.get('wpm') if cached else None
    for r in hist['runs']:
        if r.get('diff') == diff and r.get('mode') == mode and r.get('dur') == dur:
            w = r.get('wpm', 0)
            if best is None or w > best: best = w
    return best

def best_overall(hist):
    best = None
    for r in list(hist['runs']) + list(hist['pbs'].values()):
        if best is None or r.get('wpm', 0) > best.get('wpm', 0): best = r
    return best

# ── Key parsing ────────────────────────────────────────────────────────────
def parse_key(buf):
    """One key event from buf → (key, remaining). None = incomplete (need more
    bytes); 'NOP' = complete-but-unmapped (consumed and ignored by all states)."""
    if not buf: return None, b''
    b0 = buf[0]
    ARROWS = {'A': 'UP', 'B': 'DOWN', 'C': 'RIGHT', 'D': 'LEFT'}
    if b0 == 0x1b:
        if len(buf) == 1: return None, buf   # bare ESC or split sequence — caller decides
        if buf[1] == ord('['):
            i = 2
            while i < len(buf) and not (0x40 <= buf[i] <= 0x7e): i += 1
            if i >= len(buf): return None, buf
            fin, params = chr(buf[i]), buf[2:i]
            if fin == '~' and params == b'200': return 'PASTE_S', buf[i+1:]
            if fin == '~' and params == b'201': return 'PASTE_E', buf[i+1:]
            return ARROWS.get(fin, 'NOP'), buf[i+1:]
        if buf[1] == ord('O'):               # SS3: F1-F4, app-cursor arrows
            if len(buf) < 3: return None, buf
            return ARROWS.get(chr(buf[2]), 'NOP'), buf[3:]
        return 'ESC', buf[1:]                # alt+key — treat as ESC
    if b0 in (0x0d, 0x0a): return 'ENTER',  buf[1:]
    if b0 == 0x09:         return 'TAB',    buf[1:]
    if b0 == 0x7f:         return 'BS',     buf[1:]
    if b0 == 0x08:         return 'WORDBS', buf[1:]   # ctrl+backspace on most terms
    if b0 == 0x03:         return 'CTRLC',  buf[1:]
    if b0 == 0x17:         return 'WORDBS', buf[1:]   # ctrl+w
    if b0 < 0x20:          return f'CTRL{chr(b0 + 0x40)}', buf[1:]
    if b0 < 0x80:          return chr(b0), buf[1:]
    if b0 >= 0xc0:
        w = 2 if b0 < 0xe0 else (3 if b0 < 0xf0 else 4)
        if len(buf) < w: return None, buf
        try: return buf[:w].decode('utf-8'), buf[w:]
        except UnicodeDecodeError: return 'NOP', buf[1:]
    return 'NOP', buf[1:]

